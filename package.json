{
  "name": "discord-llm-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=self-cli.js",
    "start": "concurrently --kill-others \"bun src/llm-server.ts\" \"node self-cli.js\"",
    "dev": "concurrently --kill-others \"bun --hot src/llm-server.ts\" \"esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=self-cli.js --watch\" \"bun --hot self-cli.js\"",
    "format": "bunx --bun @biomejs/biome format --write ./src",
    "check": "bunx --bun @biomejs/biome check ./src",
    "lint": "bunx --bun @biomejs/biome lint ./src",
    "lint:write": "bunx --bun @biomejs/biome lint --write ./src"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^16.4.5",
    "eris": "^0.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
