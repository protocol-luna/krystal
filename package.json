{
  "name": "discord-llm-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build-client && npm run build-server",
    "build-client": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=self-cli.js",
    "build-server": "esbuild src/llm-server.ts --bundle --platform=node --format=esm --packages=external --outfile=llm-server.js",
    "start": "concurrently --kill-others \"node llm-server.js\" \"node self-cli.js\"",
    "dev": "concurrently --kill-others \"bun --hot src/llm-server.ts\" \"esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=self-cli.js --watch\" \"bun --watch src/index.ts\"",
    "client-only": "node self-cli.js",
    "server-only": "node llm-server.js",
    "format": "bunx --bun @biomejs/biome format --write ./src",
    "check": "bunx --bun @biomejs/biome check ./src",
    "lint": "bunx --bun @biomejs/biome lint ./src",
    "lint:write": "bunx --bun @biomejs/biome lint --write ./src",
    "download-model": "mkdir models && cd models && wget https://huggingface.co/mradermacher/Discord-Hermes-3-8B-GGUF/resolve/main/Discord-Hermes-3-8B.Q2_K.gguf && cd .."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "eris": "^0.18.0",
    "js-yaml": "^4.2.0",
    "pipertts": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
