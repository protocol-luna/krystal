{
  "name": "discord-llm-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/core/llm-server.ts --bundle --platform=node --format=esm --packages=external --outfile=llm-server.js",
    "start": "node llm-server.js",
    "server-only": "node llm-server.js",
    "format": "bunx --bun @biomejs/biome format --write ./src",
    "check": "bunx --bun @biomejs/biome check ./src",
    "lint": "bunx --bun @biomejs/biome lint ./src",
    "lint:write": "bunx --bun @biomejs/biome lint --write ./src",
    "test": "bun test ./tests",
    "test:watch": "bun test --watch ./tests",
    "test:coverage": "bun test --coverage ./tests",
    "diagrams": "./scripts/export-diagrams.sh",
    "download-model": "mkdir models && cd models && wget https://huggingface.co/mradermacher/Discord-Hermes-3-8B-GGUF/resolve/main/Discord-Hermes-3-8B.Q2_K.gguf && cd .."
  },
  "dependencies": {
    "bun-types": "^1.3.14",
    "eris": "^0.18.0",
    "js-yaml": "^4.2.0",
    "pipertts": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
