%%{init: {"theme":"dark"}}%%
flowchart TD
    START(["pickReplyStyle(isActiveConversation)"])
    
    START --> ACTIVE_CONV{"isActiveConversation ?<br/>(15s window)"}
    
    ACTIVE_CONV -->|"no<br/>(cold conversation)"| COLD_ROLL["roll = Math.random()"]
    COLD_ROLL --> COLD_70{"roll < 0.7 ?"}
    COLD_70 -->|"yes"| STYLE_A["messageReference: true<br/>mentionRepliedUser: false<br/>(Quote without ping)"]
    COLD_70 -->|"no"| COLD_90{"roll < 0.9 ?"}
    COLD_90 -->|"yes"| STYLE_B["messageReference: true<br/>mentionRepliedUser: true<br/>(Quote with ping)"]
    COLD_90 -->|"no"| STYLE_C["messageReference: false<br/>mentionRepliedUser: false<br/>(Without quote, without ping)"]
    
    ACTIVE_CONV -->|"yes<br/>(active conversation)"| WEIGHTED["Weighted selection<br/>among replyStyles config"]
    
    WEIGHTED --> SUM_WEIGHTS["total = sum(weights)"]
    SUM_WEIGHTS --> ROLL["roll = Math.random() * total"]
    ROLL -->     ITERATE["For each style:<br/>roll -= entry.weight"]
    ITERATE --> CHECK_ZERO{"roll <= 0 ?"}
    CHECK_ZERO -->|"no"| ITERATE
    CHECK_ZERO -->|"yes"| SELECTED_STYLE["return entry.style"]
    
    STYLE_A --> APPLY
    STYLE_B --> APPLY
    STYLE_C --> APPLY
    SELECTED_STYLE --> APPLY
    
    APPLY["Style applied to<br/>first message createMessage()"]
    

