%%{init: {"theme":"dark"}}%%
flowchart TD
    START(["getSleepBehavior()"]) -->     CHECK_SCHED{"timeSchedules<br/>exists and non-empty ?"}
    CHECK_SCHED -->|"no"| NULL_RETURN["return null (always awake)"]
    
    CHECK_SCHED -->|"yes"| GET_TZ["Get timezone<br/>(config.yml)"]
    GET_TZ --> COMPUTE_NOW["now = new Date()<br/>localNow = toLocaleString('en-US', {timeZone: tz})<br/>currentMinutes = HH*60 + MM"]
    
    COMPUTE_NOW -->     FOR_EACH["For each entry<br/>in timeSchedules"]
    
    FOR_EACH --> PARSE["startMinutes = parseTime(start)<br/>endMinutes = parseTime(end)"]
    PARSE --> IS_IN_WINDOW{"isInWindow(currentMinutes,<br/>startMinutes, endMinutes) ?"}
    
    IS_IN_WINDOW -->|"yes"| RETURN_BEHAVIOR["return entry.behavior<br/>sleep / slow / short"]
    IS_IN_WINDOW -->|"no"| NEXT_ENTRY["Next entry (loop)"]
    
    NEXT_ENTRY --> PARSE
    NEXT_ENTRY -->|"no more entries"| NULL_RETURN2["return null"]
    
    subgraph "isInWindow(now, start, end)"
        CHECK_OVERFLOW{"start <= end ?"}
        CHECK_OVERFLOW -->|"yes (same day)"| SIMPLE{"now >= start<br/>AND now < end ?"}
        CHECK_OVERFLOW -->|"no (midnight+)"| OVERFLOW{"now >= start<br/>OR now < end ?"}
        SIMPLE -->|"yes"| TRUE_RET["true"]
        SIMPLE -->|"no"| FALSE_RET["false"]
        OVERFLOW -->|"yes"| TRUE_RET2["true"]
        OVERFLOW -->|"no"| FALSE_RET2["false"]
    end
    
    subgraph "Behaviors"
        B1["sleep: ignore except mentions/DM, status invisible"]
        B2["slow: delay x3-5, reactions capped at 2%"]
        B3["short: ignore chance +30%, reactions capped at 2%"]
        B4["null: normal behavior, all features active"]
    end
    
    RETURN_BEHAVIOR --> B1
    RETURN_BEHAVIOR --> B2
    RETURN_BEHAVIOR --> B3
    NULL_RETURN --> B4
    NULL_RETURN2 --> B4
    

