%%{init: {"theme":"dark"}}%%
graph TB
    subgraph "Entry Points"
        CLI["cli.ts<br/>CLI Dispatcher"] -->|"bot (default)"| BOT["bot.ts<br/>Discord Bot (Eris)"]
        CLI -->|"server"| SRV["llm-server.ts<br/>LLM HTTP Server"]
        CLI -->|"direct"| DIRECT["Terminal Interaction"]
    end

    subgraph "Configuration Layer"
        CFG["config.yml<br/>YAML Config"] --> CFG_TS["config.ts<br/>Parser + Hot-Reload"]
        ENV[".env<br/>Environment Overrides"] --> CFG_TS
        CFG_TS -->|"static exports"| BOT
        CFG_TS -->|"static exports"| LLMCORE
        CFG_TS -->|"live getters"| ALL_MODULES
    end

    subgraph "LLM Core"
        LLMCORE["llm-core.ts<br/>Queue + Backends"]
        LLMBUS["llm-bus.ts<br/>TypedBus<LLMEvents>"]
        LLMCLIENT["llm-client.ts<br/>HTTP Client (Proxy)"]
        LLMSRV["llm-server.ts<br/>NDJSON Server"]

        LLMCORE --> LLMBUS
        LLMCORE -->|"proxy mode"| LLMCLIENT
        LLMCLIENT -->|"HTTP POST /ask"| LLMSRV
        LLMSRV --> LLMCORE
        LLMCORE -->|"cli mode"| LLAMACLI["llama-cli<br/>(Child Process)"]
        LLMCORE -->|"server mode"| LLAMASRV["llama-server<br/>(HTTP SSE)"]
    end

    subgraph "State Management"
        STATE["state.ts<br/>In-Memory State"]
        STATEBUS["state-bus.ts<br/>TypedBus<StateEvents>"]
        PERSIST["persistence.ts<br/>Auto-Save/Load"]
        STATE --> STATEBUS
        STATEBUS --> PERSIST
        PERSIST -->|"state.json"| DISK[(state.json)]
    end

    subgraph "Bot Subsystems"
        BOT
        TRIGGER["trigger.ts<br/>Trigger Evaluation"]
        PENDING["pending.ts<br/>Anti-Spam Queue"]
        REACTIONS["reactions.ts<br/>Reaction Commands"]
        GUILD["guild.ts<br/>Channel Utilities"]
        BOT -->|"evaluateMessage()"| TRIGGER
        BOT -->|"queuePending()"| PENDING
        BOT -->|"handleReactionCommand()"| REACTIONS
        SPONT["spontaneous.ts<br/>Spontaneous Messages"]
        BOT -->|"trySpawn()"| SPONT
    end

    subgraph "Human Behaviors"
        MANNER["mannerisms.ts<br/>Delay/Ignore/React"]
        SLEEP["sleep.ts<br/>Sleep Schedules"]
        TYPO["typo.ts<br/>Keyboard Typos"]
        MANNER -->|"getSleepBehavior()"| SLEEP
    end

    subgraph "TTS Pipeline"
        PIPER["piper.ts<br/>Piper TTS Init/Synth"]
        AUDIO["audio.ts<br/>WAV→OGG, Sanitize"]
        UPLOAD["upload.ts<br/>Discord CDN 3-Step"]
        VOICE["voice-message.ts<br/>Orchestration"]
        VOICE --> PIPER
        VOICE --> AUDIO
        VOICE --> UPLOAD
    end

    subgraph "External Dependencies"
        DISCORD{{"Discord API"}}
        FFMPEG{{"ffmpeg/ffprobe"}}
        PIPER_BIN{{"Piper TTS Binary"}}
        LLAMACLI
        LLAMASRV
    end

    BOT -->|"askLLM()"| LLMCORE
    BOT -->|"sendTextAsVoiceMessage()"| VOICE
    BOT -->|"computeDelay()"| MANNER
    BOT -->|"applyTypo()"| TYPO
    BOT --- DISCORD
    UPLOAD --- DISCORD
    VOICE --> PIPER_BIN
    VOICE --> FFMPEG
