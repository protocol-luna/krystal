flowchart TD
    START(["LLM response received"]) --> TYPO_ROLL{"Math.random() <<br/>typoChance (6%) ?"}
    TYPO_ROLL -->|"no (94%)"| NO_TYPO(["No typo"])
    TYPO_ROLL -->|"yes (6%)"| PICK_WORD["Pick a random word<br/>from emitted chunks"]
    
    PICK_WORD --> APPLY["applyTypo(word, layout)<br/>AZERTY or QWERTY"]
    
    APPLY --> PICK_LETTER["pickLetter(text)<br/>index of a letter<br/>among [a-zA-Z]"]
    PICK_LETTER --> NO_LETTER{"idx === null ?<br/>only digits/symbols"}
    NO_LETTER -->|"yes"| FAIL_TYPO["Cannot correct"]
    NO_LETTER -->|"no"| FIND_ADJACENT{"adjacent[originalChar]<br/>exists ?"}
    
    FIND_ADJACENT -->|"no"| FAIL_TYPO
    FIND_ADJACENT -->|"yes"| REPLACE["Replace with a<br/>random adjacent key"]
    
    REPLACE --> BUILD_RESULT["Build TypoResult:<br/>originalWord, correctedWord"]
    BUILD_RESULT --> CORRECTION_DELAY["Wait 2-4s<br/>(typoCorrectionDelay)"]
    
    CORRECTION_DELAY --> RESOLVE_STYLE["resolveStyle()<br/>edit / message / mixed"]
    
    RESOLVE_STYLE --> IS_MIXED{"style == 'mixed' ?"}
    IS_MIXED -->|"yes"| MIXED_ROLL{"Math.random() < 0.5 ?"}
    MIXED_ROLL -->|"yes"| DO_EDIT
    MIXED_ROLL -->|"no"| DO_MESSAGE
    IS_MIXED -->|"no, edit"| DO_EDIT["editMessage(channelId, msgId, {content})"]
    IS_MIXED -->|"no, message"| DO_MESSAGE["createMessage(channelId, {content: 'word*'})"]
    
    DO_EDIT --> LOG_EDIT["log: 'typo corrected by edit'"]
    DO_MESSAGE --> LOG_MSG["log: 'typo corrected by message'"]
    

