flowchart TD
    START(["triggerLunaReply(key)<br/>channelId:userId"]) --> processing_has{"processing.has(key) ?"}
    
    processing_has -->|"no, free"| MARK["markProcessing(key)<br/>Set.add(key)"]
    processing_has -->|"yes, already in progress"| QUEUE["queuePending(key, msg, reason)<br/>Map.set(key, {msg, reason})<br/>saveAllState()"]
    QUEUE --> EXIT_QUEUED(["Wait for next call"])
    
    MARK --> EXECUTE["LLM request execution<br/>streaming, typo, TTS..."]
    EXECUTE --> DONE["doneProcessing(key)<br/>Set.delete(key)"]
    
    DONE --> DRAIN["drainPending(key)<br/>Map.get(key) / Map.delete(key)<br/>saveAllState()"]
    
    DRAIN --> EXISTS{"queued !== null ?"}
    EXISTS -->|"yes"| RECURSE["triggerLunaReply(queued.message)"]
    EXISTS -->|"no"| NORMAL_EXIT(["Done"])
    RECURSE --> processing_has
    
    subgraph "Pending Messages Map State"
        MAP_DEF["Map<channelId:userId, {message, reason}>"]
    end
    
    subgraph "Restoration (restart)"
        RESTORE["restorePending(entries, client)<br/>getMessage(channelId, msgId)<br/>Map.set(key, msg)"]
        STATE["state.json loads"] --> RESTORE
    end
    

