stateDiagram-v2
    [*] --> INITIAL
    INITIAL --> SCHEDULE_FIRST: startDynamicStatus() called
    
    SCHEDULE_FIRST --> CHECK_PRESETS: config.dynamicStatus.length > 0?
    CHECK_PRESETS --> [*]: empty presets

    state "Rotation Interval" as ROTATION {
        [*] --> SCHEDULE_NEXT: scheduleNextStatus(baseMs)
        SCHEDULE_NEXT --> JITTER_CALC: delay = baseMs * (0.5 + Math.random() * 1.0)
        JITTER_CALC --> CLAMP_DELAY: delay = max(60000, delay)
        CLAMP_DELAY --> SET_TIMEOUT: setTimeout(updateStatus, delay)
        SET_TIMEOUT --> WAIT: statusTimerActive = true
        WAIT --> TIMER_DONE: timeout fires
        TIMER_DONE --> statusTimerActive = false
        TIMER_DONE --> UPDATE
    }

    state UPDATE {
        [*] --> CHECK_SLEEP: getSleepBehavior()
        CHECK_SLEEP --> SET_INVISIBLE: sleep == "sleep"
        CHECK_SLEEP --> CHECK_SKIP: not sleeping

        SET_INVISIBLE --> editStatus("invisible")
        SET_INVISIBLE --> RESCHEDULE_AFTER_SLEEP: scheduleNextStatus()

        CHECK_SKIP --> SKIP_ROLL: Math.random() < 0.1 ?
        SKIP_ROLL --> RESCHEDULE_SKIP: YES → keep current status
        SKIP_ROLL --> SELECT_PRESET: NO

        SELECT_PRESET --> REPEAT_ROLL: Math.random() < 0.15 && lastPreset >= 0 ?
        REPEAT_ROLL --> USE_LAST: YES → idx = lastPresetIndex
        REPEAT_ROLL --> NEXT_PRESET: NO → idx = statusIndex % presets.length

        NEXT_PRESET --> INCREMENT: statusIndex++
        USE_LAST --> APPLY_PRESET
        INCREMENT --> APPLY_PRESET

        APPLY_PRESET --> lastPresetIndex = idx
        APPLY_PRESET --> editStatus(preset.status, [{name: preset.text, type: preset.type}])
        APPLY_PRESET --> RESCHEDULE_NORMAL
    }

    RESCHEDULE_NORMAL --> SCHEDULE_NEXT: scheduleNextStatus(interval)
    RESCHEDULE_AFTER_SLEEP --> SCHEDULE_NEXT
    RESCHEDULE_SKIP --> SCHEDULE_NEXT

    note right of JITTER_CALC: Jitter 0.5x-1.5x\npour éviter la périodicité parfaite\nMinimum 60s
    note right of SKIP_ROLL: 10% de chance de\nsauter un changement\ngardant le status actuel
    note right of REPEAT_ROLL: 15% de chance de\nrépéter le dernier preset\n(pour de la continuité)
