flowchart TD
    START(["Timer 5min"]) --> CHANCE{"Math.random() <<br/>spontaneousChance (12%) ?"}
    CHANCE -->|"no"| WAIT(["Next cycle"])
    CHANCE -->|"yes"| BUSY{"isLLMBusy() ?"}
    BUSY -->|"yes"| WAIT

    BUSY -->|"no"| PICK["pickWeightedGuild(client)<br/>Whitelist filter<br/>Sort by lastMessageID<br/>Decreasing linear weight"]

    PICK --> SELECTED{"Channel found ?"}
    SELECTED -->|"no"| WAIT
    SELECTED -->|"yes"| FETCH["fetchContext(channel, N)<br/>getMessages({limit: 5})<br/>→ username: content"]

    FETCH --> RESET["resetLLM() → /clear"]
    RESET --> PROMPT["Build prompt:<br/>'Join the conversation...'"]

    PROMPT --> ASK["askLLM({username: 'system', text})"]
    ASK --> REPLY{"reply.trim()<br/>non-empty ?"}
    REPLY -->|"no"| EMPTY["log: empty response"]
    REPLY -->|"yes"| SEND["createMessage(channel, reply)"]
    SEND --> MARK["markBotActivity(channel.id)"]
    SEND --> ERR{"Error ?"}
    ERR -->|"yes"| PERM["log: permission failure"]
    MARK --> RESET_AGAIN["resetLLM()"]
    PERM --> RESET_AGAIN
    EMPTY --> RESET_AGAIN
    RESET_AGAIN --> WAIT
