flowchart TD
    A["💬 Message received"] --> CMD{"Command ?<br/>-stop / -start / -clear"}
    CMD -->|"yes"| CMD_OK["✅ Executed silently"]

    CMD -->|"no"| TRIG{"Trigger ?<br/>mention / dm / name<br/>keyword / random"}
    TRIG -->|"no"| FUP{"canFollowUp ?<br/><15s, <3/60s"}
    FUP -->|"no"| END["👋 Ignored"]

    TRIG -->|"yes"| SLEEP{"Sleep ?"}
    SLEEP -->|"sleep + not mention"| IGNORE_SLP["😴 Ignored"]
    SLEEP -->|"slow / short"| IGNORE_ROLL{"shouldIgnore ?<br/>+30% on short"}
    IGNORE_ROLL -->|"yes"| IGNORED["🙈 Ignored"]
    IGNORE_ROLL -->|"no"| FORGET{"Forget ?<br/>3%"}
    FORGET -->|"yes"| FORGOT["💀 Forgotten"]
    FORGET -->|"no"| IGNORE_SLP

    SLEEP -->|"awake"| FILTERS["Filters:<br/>- session limit (8 msgs)<br/>- anti-spam (processing)"]
    FILTERS --> DELAY["⏳ Delay<br/>computeDelay()"]

    DELAY --> REACT["Reaction ?<br/>2-8% depending on type"]
    REACT --> LLM["🤖 askLLM()<br/>proxy (llm-server) / online (OpenAI API)"]

    LLM --> STREAM["Word-by-word emission<br/>20-80ms between words"]
    STREAM --> FLUSH["Send in batches<br/>(1 newline = 1 message)"]
    FLUSH --> TTS["🗣️ Voice message ?<br/>(8-12%)"]
    TTS --> TYPO["✍️ Typo ?<br/>(6%)"]
    TYPO --> DONE["✔️ Response sent"]

    FUP -->|"yes"| DELAY

    style CMD_OK fill:#8f8
    style END fill:#f88
    style IGNORE_SLP fill:#f88
    style IGNORED fill:#f88
    style FORGOT fill:#f88
