flowchart TD
    START(["Message received"]) --> BOT_AUTHOR{"author.bot ?"}
    BOT_AUTHOR -->|"yes"| SKIP["❌ shouldRespond=false<br/>reason=null"]
    
    BOT_AUTHOR -->|"no"| TEXT_STOP{"message.content<br/>== '-stop' ?"}
    TEXT_STOP -->|"yes"| STOP["✅ shouldRespond=true<br/>reason='stop'"]
    
    TEXT_STOP -->|"no"| TEXT_START{"message.content<br/>== '-start' ?"}
    TEXT_START -->|"yes"| START_CMD["✅ shouldRespond=true<br/>reason='start'"]
    
    TEXT_START -->|"no"| TEXT_CLEAR{"message.content<br/>== '-clear' ?"}
    TEXT_CLEAR -->|"yes"| CLEAR_CMD["✅ shouldRespond=true<br/>reason='clear'"]
    
    TEXT_CLEAR -->|"no"| IS_BOT{"botId === message.author.id<br/>(self) ?"}
    IS_BOT -->|"yes"| SKIP_SELF["❌ shouldRespond=false<br/>reason=null"]
    
    IS_BOT -->|"no"| IS_MENTIONED{"message.mentions<br/>contains botId ?"}
    IS_MENTIONED -->|"yes"| MENTION["✅ shouldRespond=true<br/>reason='mention'<br/>setPaused(false)"]
    
    IS_MENTIONED -->|"no"| IS_DM{"DM &&<br/>replyInDM ?"}
    IS_DM -->|"yes"| DM["✅ shouldRespond=true<br/>reason='dm'"]
    
    IS_DM -->|"no"| STILL_DM{"DM but<br/>!replyInDM ?"}
    STILL_DM -->|"yes"| DM_IGNORE["❌ shouldRespond=false<br/>DM ignored"]
    
    STILL_DM -->|"no"| IS_PAUSED{"isPaused() ?"}
    IS_PAUSED -->|"yes"| PAUSED["❌ shouldRespond=false<br/>reason: paused"]
    
    IS_PAUSED -->|"no"| ON_COOLDOWN{"isOnCooldown() &&<br/>!mention && !followUp ?"}
    ON_COOLDOWN -->|"yes"| COOLDOWN["❌ shouldRespond=false<br/>reason: cooldown"]
    
    ON_COOLDOWN -->|"no"| HAS_BOT_NAME{"hasWord(content,<br/>botName.toLowerCase()) ?"}
    HAS_BOT_NAME -->|"yes"| NAME1["✅ shouldRespond=true<br/>reason='name'<br/>markReplied()"]
    
    HAS_BOT_NAME -->|"no"| HAS_CUSTOM_NAME{"hasWord(content,<br/>config.names[i]) ?"}
    HAS_CUSTOM_NAME -->|"yes"| NAME2["✅ shouldRespond=true<br/>reason='name'<br/>markReplied()"]
    
    HAS_CUSTOM_NAME -->|"no"| HAS_KEYWORD{"hasWord(content,<br/>config.keywords[i]) ?"}
    HAS_KEYWORD -->|"yes"| KEYWORD["✅ shouldRespond=true<br/>reason='keyword'<br/>markReplied()"]
    
    HAS_KEYWORD -->|"no"| IS_FOLLOWUP{"isFollowUp<br/>(flag) ?"}
    IS_FOLLOWUP -->|"yes"| FOLLOWUP["✅ shouldRespond=true<br/>reason='follow-up'"]
    
    IS_FOLLOWUP -->|"no"| RANDOM_ROLL{"randomChance > 0 &&<br/>Math.random() < randomChance ?"}
    RANDOM_ROLL -->|"yes (1.5%)"| RANDOM["✅ shouldRespond=true<br/>reason='random'<br/>markReplied()"]
    
    RANDOM_ROLL -->|"no (98.5%)"| NOTHING["❌ shouldRespond=false<br/>reason=null"]
    
    style SKIP fill:#f88,stroke:#333
    style STOP fill:#8f8,stroke:#333
    style START_CMD fill:#8f8,stroke:#333
    style CLEAR_CMD fill:#8f8,stroke:#333
    style SKIP_SELF fill:#f88,stroke:#333
    style MENTION fill:#8f8,stroke:#333
    style DM fill:#8f8,stroke:#333
    style DM_IGNORE fill:#f88,stroke:#333
    style PAUSED fill:#f88,stroke:#333
    style COOLDOWN fill:#f88,stroke:#333
    style NAME1 fill:#8f8,stroke:#333
    style NAME2 fill:#8f8,stroke:#333
    style KEYWORD fill:#8f8,stroke:#333
    style FOLLOWUP fill:#8f8,stroke:#333
    style RANDOM fill:#8f8,stroke:#333
    style NOTHING fill:#f88,stroke:#333
