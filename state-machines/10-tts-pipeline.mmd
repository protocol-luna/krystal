%%{init: {"theme":"dark"}}%%
flowchart TD
    START(["sendTextAsVoiceMessage()"]) --> TTS_READY{"isTTSReady() ?"}
    TTS_READY -->|"non"| WARN_NO_TTS["Piper not ready<br/>skip voice message"]
    TTS_READY -->|"oui"| SANITIZE["sanitizeForTTS(text)"]
    
    SANITIZE --> REPLACE_MENTIONS["<@123> to @user"]
    REPLACE_MENTIONS --> REMOVE_CHANNELS["<#123> to ''"]
    REMOVE_CHANNELS --> REMOVE_EMOJIS["<:name:id> to ''"]
    REMOVE_EMOJIS --> REMOVE_URLS["https://... to ''"]
    REMOVE_URLS --> STRIP_NON_TEXT["Remove [^\\p{L}\\p{N}\\s@]"]
    STRIP_NON_TEXT --> TRUNCATE["Truncate to 500 characters"]
    TRUNCATE --> CHECK_EMPTY{"Empty text after<br/>cleaning ?"}
    
    CHECK_EMPTY -->|"yes"| WARN_EMPTY["Empty text<br/>skip voice message"]
    CHECK_EMPTY -->|"no"| CHECK_UNSAFE{"hasUnsafeTTSText() ?<br/>(emoji ranges)"}
    
    CHECK_UNSAFE -->|"yes"| UNSAFE["Unsafe text (emoji)<br/>send as text instead"]
    CHECK_UNSAFE -->|"non"| SYNTHESIZE["piper.synthesize(safeText)<br/>{audio: Buffer WAV}"]
    
    SYNTHESIZE --> WAV_TO_OGG["wavToOgg(wavBuf)<br/>ffmpeg libopus 32k<br/>24000Hz mono"]
    
    WAV_TO_OGG --> GET_DURATION["getAudioDuration(oggBuf)<br/>ffprobe duration_secs"]
    GET_DURATION --> BUILD_WAVEFORM["buildWaveformBase64()<br/>sine wave 256 points base64"]
    
    BUILD_WAVEFORM --> REQUEST_UPLOAD["requestUploadUrl()<br/>POST Discord /attachments"]
    REQUEST_UPLOAD --> PARSE_UPLOAD["Extraire upload_url<br/>et upload_filename"]
    
    PARSE_UPLOAD --> PUT_FILE["putFileToUploadUrl()<br/>PUT ogg vers CDN Discord"]
    PUT_FILE --> POST_MESSAGE["postVoiceMessage()<br/>POST message flags=8192<br/>(voice message type)"]
    
    POST_MESSAGE --> SUCCESS["Voice message sent"]
    WARN_NO_TTS --> DONE_DUMMY
    WARN_EMPTY --> DONE_DUMMY
    UNSAFE --> DONE_DUMMY
    

