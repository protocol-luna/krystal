graph TB
    subgraph "TypedBus<LLMEvents> - llmBus"
        LLMBUS[("llmBus<br/>(new TypedBus<LLMEvents>)")]
        
        subgraph "Emitters"
            CORE["llm-core.ts"]
            CORE_WORD["emitWordTokens()"]
            CORE_CRASH["scheduleRestart()"]
            CORE_BACKEND["serverRequest() / proxyRequest()"]
        end
        
        subgraph "Events"
            TOKEN["token (chunk: string)<br/>Individual word emitted"]
            FLUSH["flush ()<br/>End of a word chunk"]
            DONE["done (fullText: string)<br/>Full text generated"]
            ERROR["error (err: Error)<br/>LLM Error"]
            CRASH["crash (code: number|null)<br/>llama-cli crash"]
            READY["ready ()<br/>LLM model ready"]
            RESET["reset ()<br/>LLM context empty"]
        end
        
        subgraph "Subscribers"
            BOT_TOKEN["bot.ts on('token')<br/>accumulates chunks"]
            BOT_FLUSH["bot.ts on('flush')<br/>createMessage()"]
            BOT_ONCE["bot.ts once('token')<br/>startTyping()"]
            CORE_DONE["llm-core.ts on('done')<br/>item.resolve()"]
        end
    end

    subgraph "TypedBus<StateEvents> - stateBus"
        STATEBUS[("stateBus<br/>(new TypedBus<StateEvents>)")]
        
        subgraph "State Emitters"
            ST_SET["state.ts setPaused()"]
            ST_MARK["state.ts markReplied()"]
            ST_ACT["state.ts markBotActivity()"]
            ST_TRACK["state.ts trackSpeaker()"]
            ST_CLEAR["state.ts clearCooldown()"]
        end
        
        subgraph "State Events"
            STATE_CH["state:changed ()"]
        end
        
        subgraph "State Subscribers"
            PERSIST["persistence.ts on('state:changed')<br/>scheduleSave()"]
        end
    end

    CORE_WORD --> TOKEN
    CORE_WORD --> FLUSH
    CORE_BACKEND --> DONE
    CORE_CRASH --> CRASH
    CORE --> READY
    CORE --> RESET
    CORE --> ERROR

    TOKEN --> BOT_TOKEN
    FLUSH --> BOT_FLUSH
    TOKEN --> BOT_ONCE
    DONE --> CORE_DONE

    ST_SET --> STATE_CH
    ST_MARK --> STATE_CH
    ST_ACT --> STATE_CH
    ST_TRACK --> STATE_CH
    ST_CLEAR --> STATE_CH

    STATE_CH --> PERSIST


