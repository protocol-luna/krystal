gantt
    title Example of complete timing cycle
    dateFormat  X
    axisFormat %s

    section Evaluation & Filtres
    messageCreate received      :0, 1
    skip bot author              :0, 1
    eval trigger                 :1, 2
    handle command               :2, 2
    sleep check                  :2, 2
    session check                :2, 2
    ignore check                 :2, 1
    forget check                 :2, 1

    section Delay & Wait
    computeDelay (base 800-4000) :crit, 3, 60
    setTimeout delay             :crit, 63, 223

    section Reaction optionnelle
    shouldReact ?                :63, 1
    addReaction (API)            :64, 10

    section LLM Execution
    triggerLunaReply setup       :63, 5
    askLLM (file queue)          :68, 2
    LLM processing (1-5s)        :crit, 70, 500
    first token received         :milestone, 570, 2
    token emission (20-80ms/word) :570, 200
    flush message 1              :crit, 600, 15
    token emission (continued)  :615, 150
    flush message 2              :crit, 750, 15
    residual flush               :crit, 765, 15

    section TTS (optionnel)
    shouldSendVoice ?            :570, 2
    TTS pipeline (synthese)      :crit, 572, 150
    upload Discord               :crit, 722, 50

    section Corrections
    typo correction (2-4s)       :770, 350
    correction message           :crit, 1120, 15

    section Cleaning
    doneProcessing               :crit, 765, 2
    drainPending                 :767, 3
    checkSessionLimit            :770, 5
