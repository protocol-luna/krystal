stateDiagram-v2
    [*] --> IDLE
    
    IDLE --> BOT_REPLIED: triggerLunaReply completes
    BOT_REPLIED --> BOT_SPOKE: trackSpeaker(botId) sets lastSpeaker = botId
    BOT_SPOKE --> WATCHING: waiting 15s window
    
    WATCHING --> USER_REPLIES: user sends message in same channel
    WATCHING --> EXPIRED_WINDOW: 15s elapsed, no user message
    
    EXPIRED_WINDOW --> IDLE
    
    USER_REPLIES --> CHECK_FOLLOWUP: canFollowUp() called
    
    CHECK_FOLLOWUP --> CHECK_RECENT_BOT: isRecentBotActivity(channel, 15000)?
    CHECK_RECENT_BOT --> CHECK_SPEAKER: YES, lastSpeaker?.userId === botId?
    CHECK_RECENT_BOT --> NOT_FOLLOWUP: NO (bot inactive >15s)
    
    CHECK_SPEAKER --> CHECK_COUNT: YES, responseCount < MAX_FOLLOWUPS (3)?
    CHECK_SPEAKER --> NOT_FOLLOWUP: NO (someone else spoke last)
    
    CHECK_COUNT --> FOLLOWUP_READY: YES, canFollowUp = true
    CHECK_COUNT --> NOT_FOLLOWUP: NO, MAX_FOLLOWUPS reached
    
    FOLLOWUP_READY --> APPLY_DELAY: computeDelay("follow-up")
    APPLY_DELAY --> MAYBE_REACT: shouldReact("follow-up")?
    MAYBE_REACT --> ADD_REACTION_IF: YES, addReaction
    MAYBE_REACT --> EXECUTE_FOLLOWUP: NO
    
    ADD_REACTION_IF --> EXECUTE_FOLLOWUP
    EXECUTE_FOLLOWUP --> TRIGGER_REPLY_FUP: triggerLunaReply
    EXECUTE_FOLLOWUP --> INCREMENT_COUNT: markReplied + responseCount++
    INCREMENT_COUNT --> IDLE
    
    NOT_FOLLOWUP --> IDLE

    state BUDGET {
        COUNT0: responseCount = 0
        COUNT1: responseCount = 1
        COUNT2: responseCount = 2
        COUNT3: responseCount = 3 max
        
        COUNT0 --> COUNT1: follow-up responded
        COUNT1 --> COUNT2: another follow-up
        COUNT2 --> COUNT3: third follow-up
        COUNT3 --> BLOCKED: budget exhausted
        
        COUNT1 --> COUNT0: 60s timeout
        COUNT2 --> COUNT1: 60s timeout
        COUNT3 --> COUNT2: 60s timeout
    }


