%%{init: {"theme":"dark"}}%%
flowchart TD
    START(["Timer: setInterval(5min)"]) --> CHANCE_ROLL{"Math.random() <<br/>spontaneousChance (12%) ?"}
    CHANCE_ROLL -->|"no (88%)"| WAIT(["Wait for next cycle"])
    CHANCE_ROLL -->|"yes (12%)"| CHECK_BUSY{"isLLMBusy() ?"}
    CHECK_BUSY -->|"yes"| WAIT
    CHECK_BUSY -->|"no"| PICK_GUILD["pickWeightedGuild(client)"]
    
    PICK_GUILD --> FILTER_GUILDS["Filter by whitelist<br/>(spontaneousWhitelist)"]
    FILTER_GUILDS --> RANK_CHANNELS["Rank guilds by<br/>activity (lastMessageID)"]
    
    RANK_CHANNELS --> LINEAR_WEIGHT["Linear weighted selection<br/>weight = (rank + 1)"]
    LINEAR_WEIGHT --> SELECTED{"A guild/channel<br/>was selected ?"}
    SELECTED -->|"no"| WAIT
    SELECTED -->|"yes"| CHECK_CACHE["Check cache (60s TTL)<br/>findMostActiveChannel()"]
    
    CHECK_CACHE --> FETCH_CONTEXT["fetchContext(channel, N)<br/>getMessages({limit: N})"]
    FETCH_CONTEXT --> BUILD_PROMPT["Build the system prompt"]
    
    BUILD_PROMPT --> RESET_CONTEXT["resetLLM() / clear"]
    RESET_CONTEXT --> ASK_LLM["askLLM({username: 'system', text})"]
    
    ASK_LLM --> CHECK_REPLY{"reply.trim()<br/>is not empty ?"}
    CHECK_REPLY -->|"no"| EMPTY_LOG["log: 'empty response'"]
    CHECK_REPLY -->|"yes"| SEND_MESSAGE["client.createMessage(channel.id, reply)"]
    
    SEND_MESSAGE --> MARK_ACTIVITY["markBotActivity(channel.id)"]
    SEND_MESSAGE --> CATCH_ERROR{"Error ?<br/>(permissions)"}
    CATCH_ERROR -->|"yes"| PERM_LOG["log: 'send failure'"]
    
    MARK_ACTIVITY --> RESET_AGAIN["resetLLM()"]
    PERM_LOG --> RESET_AGAIN
    EMPTY_LOG --> RESET_AGAIN
    RESET_AGAIN --> WAIT


