flowchart TD
    START(["watchConfig()"]) -->     CHECK_EXISTS{"config.yml<br/>exists ?"}
    CHECK_EXISTS -->|"no"| EXIT(["No watch"])
    CHECK_EXISTS -->|"yes"| FS_WATCH["fs.watch(configPath,<br/>(event) => ...)"]
    
    FS_WATCH -->     WAIT_CHANGE["Waiting for change..."]
    WAIT_CHANGE --> EVENT_FIRED{"event === 'change' ?"}
    EVENT_FIRED -->|"rename / delete"| IGNORE(["Ignore"])
    EVENT_FIRED -->|"change"| TRY_PARSE["Attempt to parse<br/>the new YAML"]
    
    TRY_PARSE -->     PARSE_OK["yaml.load()<br/>rawCfg updated"]
    TRY_PARSE -->     PARSE_ERR{"YAML parse<br/>error ?"}
    PARSE_ERR -->|"yes"| LOG_ERROR["console.error(err)<br/>old config remains active"]
    PARSE_ERR -->|"no"| LOG_OK["console.log: hot-reloaded"]
    PARSE_OK --> LOG_OK
    
    LOG_OK --> UPDATE_LIVE["Les getters du 'config' object<br/>utilisent rawCfg (valeurs a jour)"]
    
    subgraph "What changes live"
        HOT1["names, keywords, randomChance, cooldownSeconds"]
        HOT2["concentration thresholds (delays, ignore, reaction)"]
        HOT3["typoChance, hesitationChance, forgetChance"]
        HOT4["voiceMessageChance, serverEmojiChance"]
        HOT5["timeSchedules, dynamicStatus"]
        HOT6["sessionMessageLimit, replyStyles"]
    end
    
    subgraph "What requires a restart"
        COLD1["DISCORD_TOKEN"]
        COLD2["LLAMA_CLI_PATH, LLAMA_MODEL_PATH"]
        COLD3["LLM_HOST, LLM_PORT, LLM_MODE"]
        COLD4["SYSTEM_PROMPT"]
        COLD5["llamaArgs (tous les flags)"]
        COLD6["ttsModelPath, ffmpegPath, ..."]
    end
    
    UPDATE_LIVE --> HOT1
    UPDATE_LIVE --> HOT2
    UPDATE_LIVE --> HOT3
    UPDATE_LIVE --> HOT4
    UPDATE_LIVE --> HOT5
    UPDATE_LIVE --> HOT6
    

