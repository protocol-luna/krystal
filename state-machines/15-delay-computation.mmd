%%{init: {"theme":"dark"}}%%
flowchart TD
    START(["computeDelay(reason, sleepBehavior, msgLength, inactivityMs)"])
    
    START -->     GET_THRESHOLDS["Get ConcentrationEntry<br/>based on trigger type"]
    
    GET_THRESHOLDS --> BASE_DELAY["delay = delay_min + Math.random() * (delay_max - delay_min)"]
    
    BASE_DELAY --> READING_CHECK{"msgLength > 0 ?"}
    READING_CHECK -->|"yes"| READING_FACTOR["readingFactor = min(msgLength / 500, 3)"]
    READING_FACTOR --> READING_MULT["delay *= 1 + readingFactor * (0.3 + Math.random() * 0.7)"]
    READING_CHECK -->|"no"| INACTIVITY_CHECK
    
    READING_MULT --> INACTIVITY_CHECK
    
    INACTIVITY_CHECK{"inactivityMs !== undefined<br/>AND > warmupMinutes (10) ?"}
    INACTIVITY_CHECK -->|"yes"| WARMUP["inactivityRatio = min(inactivityMs / warmupMs, 5)<br/>delay *= 1 + (inactivityRatio * multiplier - 1) * (0.5 + Math.random() * 0.5)"]
    INACTIVITY_CHECK -->|"no"| SLEEP_CHECK
    
    WARMUP --> SLEEP_CHECK
    
    SLEEP_CHECK{"sleepBehavior == 'slow' ?"}
    SLEEP_CHECK -->|"yes"| SLOW_MULT["delay *= 3 + Math.random() * 2<br/>(x3 to x5)"]
    SLEEP_CHECK -->|"no"| JITTER
    
    SLOW_MULT --> JITTER
    
    JITTER["delay *= 0.5 + Math.random() * 1.5<br/>aggressive jitter x0.5 to x1.5"]
    
    JITTER --> RETURN["return delay (ms)"]


